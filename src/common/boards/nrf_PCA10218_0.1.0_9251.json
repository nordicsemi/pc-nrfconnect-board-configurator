        {
            "type": "switch",
            "id": "pw-monitor-led-control",
            "title": "Power to power monitor LED",
            "label": "Disable to set the power monitor LED to off.",
            "tooltip": "When enabled, LED will blink if the power monitor comparator or nPM1300 ADC readings are low.",
            "enable": {
                "pin": 5
            }
        },
        {
            "type": "switch",
            "id": "swd-control",
            "title": "Software Debugger (SWD)",
            "label": "Disable to use an external debugger on the target chip.",
            "tooltip": "When enabled, the SWD is connected and the IMCU is acting as the debugger. When disabled, the SWD is disconnected and you can use an external debugger connected to the Debug In header.",
            "enable": {
                "pin": 6
            }
        },
        {
            "type": "switch",
            "id": "ledcontrol",
            "title": "Power to LEDs",
            "label": "Disable to have LEDs unpowered (and kept off).",
            "tooltip": "Enabling this option powers the LEDs.",
            "enable": {
                "pin": 45
            }
        },
        {
            "type": "switch",
            "id": "qspi-control",
            "title": "External memory",
            "label": "Enable external flash",
            "tooltip": "When enabled, the QSPI pins (P5.00-P5.05) are connected to the external memory. When disabled, the QSPI pins are routed to the PORT5 header (P5).",
